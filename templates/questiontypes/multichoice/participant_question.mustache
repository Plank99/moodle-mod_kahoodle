{{!
    @template mod_kahoodle/questiontypes/multichoice/participant_question

    Shown to participants for multiple choice questions during the question stage.

    Example context (json):
    {
        "sortorder": 3,
        "answered": false,
        "avatarurl": "/user/pix.php/2/f1.jpg",
        "displayname": "Alex Johnson",
        "totalscore": 150,
        "typedata": {
            "manyoptions": true,
            "multiselect": true,
            "options": [
                {
                    "optionnumber": 1,
                    "letter": "A"
                },
                {
                    "optionnumber": 2,
                    "letter": "B"
                },
                {
                    "optionnumber": 3,
                    "letter": "C"
                },
                {
                    "optionnumber": 4,
                    "letter": "D"
                },
                {
                    "optionnumber": 5,
                    "letter": "E"
                },
                {
                    "optionnumber": 6,
                    "letter": "F"
                },
                {
                    "optionnumber": 7,
                    "letter": "G"
                },
                {
                    "optionnumber": 8,
                    "letter": "H"
                }
            ]
        }
    }
}}
{{< mod_kahoodle/participant/common/base }}
{{$ main_content }}
{{> mod_kahoodle/participant/common/questionheader }}

<div class="mod_kahoodle-participant-question-content" data-questiontype="multichoice">
    {{^answered}}

    {{! Question type specific content - answer options }}
    {{#typedata}}
    <div class="mod_kahoodle-options{{#manyoptions}} mod_kahoodle-options-many{{/manyoptions}}"
        {{#multiselect}}data-multiselect="1"{{/multiselect}}>
        <div class="mod_kahoodle-options-grid{{#manyoptions}} mod_kahoodle-options-grid-compact{{/manyoptions}}">
            {{#options}}
            <div class="mod_kahoodle-option mod_kahoodle-option{{optionnumber}}" data-option="{{optionnumber}}">
                <div class="mod_kahoodle-option-icon">
                    <span class="mod_kahoodle-icon-letter">{{{letter}}}</span>
                </div>
            </div>
            {{/options}}
        </div>
        {{#multiselect}}
        <div class="mod_kahoodle-options-confirm">
            <p class="mod_kahoodle-options-hint">{{#str}} multichoice_selectall, mod_kahoodle {{/str}}</p>
            <button type="button" class="btn btn-primary" data-action="submit-answer" disabled>
                {{#str}} multichoice_submitanswer, mod_kahoodle {{/str}}
            </button>
        </div>
        {{/multiselect}}
    </div>
    {{/typedata}}

    {{/answered}}

    {{#answered}}
    {{> mod_kahoodle/participant/common/waiting_after_answer }}
    {{/answered}}
</div>

{{> mod_kahoodle/participant/common/participantinfo }}
{{/ main_content }}
{{/ mod_kahoodle/participant/common/base }}

{{#js}}
require(['core/pubsub', 'mod_kahoodle/events'], function(PubSub, KahoodleEvents) {
    var container = document.querySelector(
        '.mod_kahoodle-participant-question-content[data-questiontype="multichoice"] .mod_kahoodle-options'
    );
    if (!container) {
        return;
    }
    var options = container.querySelectorAll('.mod_kahoodle-option[data-option]');
    // Questions with several correct answers collect a selection instead of submitting on the first tap.
    var multiselect = container.dataset.multiselect === '1';
    var confirmButton = container.querySelector('[data-action="submit-answer"]');

    var selection = function() {
        return Array.prototype.filter.call(options, function(opt) {
            return opt.classList.contains('mod_kahoodle-option-selected');
        }).map(function(opt) {
            return opt.dataset.option;
        });
    };

    var submit = function(response) {
        // Visual feedback - disable all options.
        options.forEach(function(opt) {
            opt.classList.add('mod_kahoodle-option-disabled');
        });
        if (confirmButton) {
            confirmButton.disabled = true;
        }
        // Dispatch event for participant.js to catch.
        PubSub.publish(KahoodleEvents.ANSWER, response);
    };

    options.forEach(function(el) {
        el.addEventListener('click', function(e) {
            e.preventDefault();
            if (this.classList.contains('mod_kahoodle-option-disabled')) {
                // Already answered.
                return;
            }
            if (!multiselect) {
                this.classList.add('mod_kahoodle-option-selected');
                submit(String(this.dataset.option));
                return;
            }
            // The answer is only sent when the participant confirms, so the clock
            // keeps running while they are still picking options.
            this.classList.toggle('mod_kahoodle-option-selected');
            confirmButton.disabled = selection().length === 0;
        });
    });

    if (confirmButton) {
        confirmButton.addEventListener('click', function(e) {
            e.preventDefault();
            var selected = selection();
            if (!selected.length) {
                return;
            }
            submit(selected.join(','));
        });
    }
});
{{/js}}
